# Copy this file to .env and fill in your own values.
# \.env must never be committed — it holds your bot token.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token -> Copy
DISCORD_TOKEN=

# Application ID: Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=

# Test server ID: right-click the server in Discord with Developer Mode on -> Copy Server ID
GUILD_ID=
